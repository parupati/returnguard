# Copy to agent/.env and fill in. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Bloomreach Engagement (Project settings > Access management > API)
BLOOMREACH_API_BASE_URL=
BLOOMREACH_PROJECT_TOKEN=
BLOOMREACH_API_KEY_ID=
BLOOMREACH_API_SECRET=
BLOOMREACH_CUSTOMER_ID_TYPE=email_id

# Databricks (SQL Warehouse > Connection details). Auth is a browser login, so no token here.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=databricks-hackathon
DATABRICKS_SCHEMA=frontier
DATABRICKS_SOURCE_SCHEMA=00data

# Shopify (from `shopify app env show`). Tokens are fetched at runtime.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
